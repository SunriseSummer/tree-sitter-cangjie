{
  "name": "tree-sitter-cangjie-repository",
  "version": "1.0.5",
  "private": true,
  "description": "Repository orchestration and integration tests for tree-sitter-cangjie",
  "license": "MulanPSL-2.0",
  "scripts": {
    "bootstrap": "npm ci --prefix parser && npm ci --prefix bindings/node",
    "generate": "npm --prefix parser run generate",
    "build": "npm run generate && npm run build:node && npm run build:wasm",
    "build:node": "npm --prefix bindings/node run build",
    "build:wasm": "node scripts/build-wasm.mjs parser/tree-sitter-cangjie.wasm",
    "build:python": "python -m build bindings/python",
    "test": "npm run test:parser && npm run test:node && npm run build:wasm && npm run test:wasm",
    "test:parser": "npm --prefix parser test",
    "test:node": "node --test --test-concurrency=1 tests/node/parser.test.js tests/node/corpus.test.js tests/node/queries/run_all.js",
    "test:wasm": "node scripts/test-wasm.mjs parser/tree-sitter-cangjie.wasm",
    "test:python": "python -m pytest bindings/python/tests",
    "snapshots:update": "node scripts/generate-ast-snapshots.cjs",
    "corpus:update": "node scripts/update-corpus.cjs",
    "verify:release": "node scripts/validate-release.mjs",
    "verify": "npm test && npm run verify:release"
  },
  "devDependencies": {
    "tree-sitter": "^0.25.1",
    "web-tree-sitter": "0.26.11"
  }
}
